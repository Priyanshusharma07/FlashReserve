# Application Configuration
NODE_ENV=development
PORT=3000
APP_MODE=api

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/flashreserve
DATABASE_CA_CERT_PATH=certs/aiven-ca.pem
PG_POOL_MAX=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Flash-Sale Business & Concurrency Rules
RESERVATION_TTL_SECONDS=600
MAX_RESERVATION_QUANTITY=5

# Redis Streams & Persistence Worker
REDIS_STREAM_NAME=stream:reservations
REDIS_CONSUMER_GROUP=flash_workers_group
WORKER_CONSUMER_NAME=worker-node-1
PERSISTENCE_BATCH_SIZE=500
PERSISTENCE_BATCH_INTERVAL_MS=50
EXPIRATION_SWEEPER_INTERVAL_MS=15000

# Authentication & Security
AUTH_MODE=dev
PASETO_SECRET_KEY=k4.local.7329584307520495834095834095834095834095834095834095834095834095

# Metrics & Observability
METRICS_PORT=9090
LOG_LEVEL=info
