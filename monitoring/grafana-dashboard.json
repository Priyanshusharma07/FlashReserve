  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Request Throughput (RPS by Status Code)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status_code) (rate(flash_http_requests_total[5s]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Latency Distribution (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(flash_http_request_duration_seconds_bucket[10s])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flash_http_request_duration_seconds_bucket[10s])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(flash_http_request_duration_seconds_bucket[10s])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Reservation Allocations & Outcomes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(flash_reservations_total[5s]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Worker Stream Batch Size & Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(flash_worker_batch_size_bucket[10s])) by (le))",
