# Reserved for the future verified server-side integration. No adapter reads these yet.
# localhost is usable only when running locally alongside the separate NestJS service.
BACKEND_API_URL=http://localhost:3000/api
APP_URL=http://localhost:8080
SESSION_COOKIE_NAME=flashreserve_session
ENABLE_DEV_AUTH=false
# No secrets, database URLs, Redis credentials or PASETO keys belong in browser config.