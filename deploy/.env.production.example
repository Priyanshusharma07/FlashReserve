# =================================================================
# FlashReserve Production Environment Configuration
# =================================================================

# --- Backend Application ---
NODE_ENV=production
PORT=3000
APP_MODE=api # Use 'api' for web server, 'worker' for background stream processor
LOG_LEVEL=info

# --- Database (Aiven PostgreSQL / Managed Cloud DB) ---
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_HOST:26717/defaultdb?sslmode=require
DATABASE_CA_CERT_PATH=certs/aiven-ca.pem
PG_POOL_MAX=25

# --- In-Memory Engine (Redis 7+ / Upstash / AWS ElastiCache) ---
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# --- Concurrency & Flash Drop Business Rules ---
RESERVATION_TTL_SECONDS=600 # 10-minute hold window for reservations
MAX_RESERVATION_QUANTITY=5 # Max units per customer per reservation

# --- Redis Streams Persistence Worker ---
REDIS_STREAM_NAME=stream:reservations
REDIS_CONSUMER_GROUP=flash_workers_group
WORKER_CONSUMER_NAME=worker-node-1
PERSISTENCE_BATCH_SIZE=500
PERSISTENCE_BATCH_INTERVAL_MS=50
EXPIRATION_SWEEPER_INTERVAL_MS=15000

# --- Security & PASETO Tokens ---
AUTH_MODE=prod
PASETO_SECRET_KEY=k4.local.GENERATE_A_64_CHARACTER_RANDOM_HEX_SECRET_FOR_PROD

# --- Frontend Build Environment (Vite) ---
VITE_API_URL=https://api.yourdomain.com
